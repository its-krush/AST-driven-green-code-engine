{
  "name": "ast-green-code-engine",
  "version": "1.0.0",
  "private": true,
  "description": "AST-driven static refactoring for energy-efficient JavaScript and TypeScript execution",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && mkdir -p dist/dashboard/public && cp src/dashboard/public/index.html dist/dashboard/public/index.html",
    "test": "jest --runInBand",
    "dev": "tsx src/dashboard/server.ts",
    "start": "node dist/dashboard/server.js"
  },
  "dependencies": {
    "@babel/generator": "^7.26.9",
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/unzipper": "^0.10.10",
    "@types/vscode": "^1.97.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
