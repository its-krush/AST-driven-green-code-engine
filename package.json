{
  "name": "ast-green-code-engine",
  "version": "1.0.0",
  "private": true,
  "description": "AST-driven static refactoring for energy-efficient JavaScript and TypeScript execution",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && copyfiles -u 3 src/dashboard/public/index.html dist/dashboard/public/ && copyfiles -u 3 src/extension/webview/companion.js dist/extension/webview/",
    "dev": "tsx src/dashboard/server.ts",
    "start": "node dist/dashboard/server.js",
    "package:extension": "npm run build && node scripts/package-extension.cjs"
  },
  "dependencies": {
    "@babel/generator": "^7.26.9",
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^24.23.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/unzipper": "^0.10.10",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.2.2",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
